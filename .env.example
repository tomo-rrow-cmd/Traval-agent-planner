# ============================================
# AI Travel Planner - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# ---- 数据库 ----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/travel_planner
# 仅用于显式运行 PostgreSQL 集成测试；数据库名必须以 _test 结尾。
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/travel_planner_test
REDIS_URL=redis://localhost:6379/0

# ---- LLM 服务 ----
# 主模型：DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_SDK_MAX_RETRIES=0

# 备选：豆包模型
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-xxx

# 备选：通义千问
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 地图服务 ----
# 后端 Web API Key（地理编码/POI搜索/路径规划）
AMAP_API_KEY=your_amap_api_key
# 前端 JSAPI Key（浏览器端地图渲染，可复用一个 Key 或单独申请）
VITE_AMAP_KEY=your_amap_jsapi_key
# 前端 JSAPI 2.0 安全密钥（需在高德控制台单独配置）
VITE_AMAP_SECURITY_CODE=

# ---- 天气服务 ----
# 当前天气适配器复用 AMAP_API_KEY；QWEATHER_API_KEY 保留给后续切回和风天气时使用。
QWEATHER_API_KEY=your_qweather_api_key

# ---- 美团酒旅 CLI ----
# 程序启动时会将该值写入 ~/.config/meituan-travel/config.json 的 key 字段，供 mttravel CLI 读取。
MEITUAN_TOKEN=your_meituan_travel_token
MEITUAN_TIMEOUT_SECONDS=30

# ---- Embedding / RAG ----
# 通过 ModelScope 下载并缓存本地模型。bge-m3 为 1024 维，切换后需要重建 Chroma collection。
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_LOCK_TIMEOUT_SECONDS=15
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MODEL_CACHE_DIR=./cache/modelscope
EMBEDDING_LOCAL_FILES_ONLY=true
RAG_TOP_K=40
RAG_FINAL_K=25
RERANKER_ENABLED=true
RERANKER_MODEL_ID=BAAI/bge-reranker-base
RERANKER_MODEL_CACHE_DIR=./cache/modelscope
RERANKER_LOCAL_FILES_ONLY=true

# ---- 应用配置 ----
APP_NAME=AI Travel Planner
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production
